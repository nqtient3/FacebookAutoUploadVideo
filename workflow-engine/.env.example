# ==============================================================================
# Facebook Auto Upload & Scheduled Post Studio - Environment Configuration
# ==============================================================================

# 1. Page ID (Dãy số ID của Fanpage Facebook bạn muốn đăng bài)
# Ví dụ: 109283746192841
FB_PAGE_ID=

# 2. Page Access Token (Mã truy cập trang dài hạn bắt đầu bằng EAAG...)
# Cần các quyền: pages_manage_posts, pages_read_engagement, publish_video
FB_PAGE_ACCESS_TOKEN=

# 3. Phiên bản Graph API của Meta (Mặc định: v19.0)
FB_GRAPH_API_VERSION=v19.0

# 4. Cổng chạy Server nội bộ
PORT=3000
